# Gloo AI OAuth client credentials (required for the Gloo provider).
# Get these from Gloo Studio → Developer Console → OAuth Clients.
GLOO_CLIENT_ID=your-gloo-client-id
GLOO_CLIENT_SECRET=your-gloo-client-secret

# Base URL for the Gloo platform. Defaults to production.
# For local dev: set to `http://localhost:8000` and pair with the
# /gloo-local-dev skill (brings up the ai-api stack on :8000).
GLOO_BASE_URL=https://platform.ai.gloo.com

# Optional — non-Gloo providers / paths used by some skills.
DEEPSEEK_API_KEY=your-deepseek-api-key
AI_API_DIR=/path/to/your/ai-api
